# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Neon Postgres connection string — a project separate from mcsu-app's.
# Neon Console -> New Project -> name it "minai" -> Connect -> "Connection string" (pooled).
# Must include ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/minai?sslmode=require"

# Signs session cookies. Generate one with:
#   npx @better-auth/cli@latest secret
# Use a DIFFERENT value in production than in development.
BETTER_AUTH_SECRET="replace-me-with-a-32-plus-character-random-string"

# Port `next dev` / `next start` listen on. Defaults to 3000 if omitted. Set
# to something other than mcsu-app's port (4000) so both can run at once —
# 4100 is a reasonable default.
PORT=4100

# The canonical origin of this deployment. Auth callbacks are built from it.
# Local:      http://localhost:4100  (or whatever PORT above is set to)
# Production: https://your-app.vercel.app  (or your custom domain — PORT is
#             irrelevant on Vercel, which fronts the app on 443 regardless)
BETTER_AUTH_URL="http://localhost:4100"
